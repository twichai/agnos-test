# Copy this file to .env and replace placeholder values.
# Keep real secrets only in .env (never commit).

APP_PORT=8080

# Database connection string (contains password => keep secret)
DB_URL=postgres://postgres:CHANGE_ME_DB_PASSWORD@localhost:5432/his?sslmode=disable

# Application secret used for sensitive operations (keep secret)
APP_SECRET=CHANGE_ME_APP_SECRET
