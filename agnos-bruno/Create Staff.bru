meta {
  name: Create Staff
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/staff/create
  body: json
  auth: none
}

body:json {
  {
    "username": "{{staffUsername}}",
    "password": "{{staffPassword}}",
    "hospital_id": "{{staffHospitalId}}"
  }
}

settings {
  encodeUrl: true
  followRedirects: true
}
